{
  "name": "pudding-plan",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "backend": "cd server && npm run dev",
    "frontend": "npm start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "start": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:localhost": "expo start --localhost",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "web": "webpack serve --mode development",
    "web:build": "webpack --mode production",
    "server": "cd server && npm start",
    "db:start": "npm run --prefix server db:start",
    "db:stop": "npm run --prefix server db:stop",
    "db:status": "npm run --prefix server db:status",
    "demo:reset": "npm run --prefix server demo:reset",
    "demo:seed": "npm run --prefix server demo:seed",
    "demo": "npm run demo:reset && npm run demo:seed && concurrently -k -n API,WEB \"npm run server\" \"npm run web\"",
    "verify": "npm run typecheck && npm test -- --runInBand && npm run lint && npm run format:check && npm run web:build && npm run --prefix server verify"
  },
  "dependencies": {
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native/new-app-screen": "0.83.4",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "babel-loader": "^10.1.1",
    "expo": "~55.0.15",
    "expo-blur": "~55.0.14",
    "expo-dev-client": "~55.0.27",
    "expo-font": "~55.0.6",
    "expo-image-picker": "~55.0.18",
    "expo-linear-gradient": "~55.0.13",
    "expo-location": "^55.1.8",
    "expo-notifications": "~55.0.19",
    "expo-secure-store": "^55.0.13",
    "expo-status-bar": "^55.0.5",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-chart-kit": "^6.12.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.2",
    "socket.io-client": "^4.8.3",
    "webpack": "^5.106.0",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.29.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@react-native/metro-config": "0.85.0",
    "@react-native/typescript-config": "0.85.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 20.0.0"
  }
}
